# ==============================================================================
# Docker Utils - Local Development Environment Variables Template
# Copy this file to .env.local and customize with your local credentials:
#   cp .env .env.local
# ==============================================================================

# ngrok Configuration
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# Core Services Credentials
KEYCLOAK_ADMIN=your_keycloak_admin_here
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here

POSTGRES_USER=your_postgres_user_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=your_postgres_db_here

# Local Catalog Connectors (Optional)
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=your_mysql_database_here

MONGO_INITDB_ROOT_USERNAME=your_mongo_username_here
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here
MONGO_INITDB_DATABASE=your_mongo_database_here

MSSQL_SA_PASSWORD=your_mssql_sa_password_here
