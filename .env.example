# ==============================================================================
# Docker Utils - Local Development Environment Variables Template
# Copy this file to .env and customize with your local credentials:
#   cp .env.example .env
# ==============================================================================

# ngrok Configuration
# Get your authtoken from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_CONFIG=/var/lib/ngrok/ngrok.yml

# Core Services Credentials
KEYCLOAK_ADMIN=your_keycloak_admin_here              # e.g. admin
KEYCLOAK_ADMIN_PASSWORD=your_keycloak_admin_password_here # e.g. admin

POSTGRES_USER=your_postgres_user_here               # e.g. postgres
POSTGRES_PASSWORD=your_postgres_password_here       # e.g. postgres
POSTGRES_DB=your_postgres_db_here                   # e.g. postgres

# Local Catalog Connectors (Optional)
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here   # e.g. root
MYSQL_DATABASE=your_mysql_database_here             # e.g. testdb

MONGO_INITDB_ROOT_USERNAME=your_mongo_username_here # e.g. root
MONGO_INITDB_ROOT_PASSWORD=your_mongo_password_here # e.g. rootpassword
MONGO_INITDB_DATABASE=your_mongo_database_here      # e.g. testdb

MSSQL_SA_PASSWORD=your_mssql_sa_password_here       # e.g. Password@123 (needs upper, lower, number, special char)

SYBASE_USER=your_sybase_user_here                   # e.g. sa
SYBASE_PASSWORD=your_sybase_password_here           # e.g. myPassword
SYBASE_DB=your_sybase_db_here                       # e.g. master
